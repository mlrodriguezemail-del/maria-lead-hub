/**
 * Maria Lead Hub backend.
 * Receives lead submissions from the GitHub Pages front end (index.html),
 * logs them to the "Leads" sheet tab, and emails the guide + a notification.
 * The FUB API key never lives here - a separate local script reads unsynced
 * leads via the admin endpoints below and creates them in Follow Up Boss
 * using the key from .env.local on Maria's machine only.
 */

var SHEET_ID = "1F8nvMhU85aE_PZxi7QjTdHwUAofIVdHrj_asqiqdN6Y";
var GUIDE_URL = "https://mlrodriguezemail-del.github.io/maria-lead-hub/guide.pdf";
var NOTIFY_EMAIL = "marialrodriguez@kw.com";

function doPost(e) {
  var body = JSON.parse(e.postData.contents);

  if (body.action === "submitLead") {
    submitLead_(body);
  } else if (body.action === "markSynced") {
    return adminMarkSynced_(body);
  }

  return ContentService.createTextOutput(JSON.stringify({ ok: true }))
    .setMimeType(ContentService.MimeType.JSON);
}

function doGet(e) {
  var p = (e && e.parameter) || {};
  if (p.action === "listUnsyncedLeads") {
    return adminListUnsyncedLeads_(p);
  }
  return ContentService.createTextOutput("Maria Lead Hub backend is running.");
}

function getSheet_() {
  return SpreadsheetApp.openById(SHEET_ID).getSheetByName("Leads")
    || SpreadsheetApp.openById(SHEET_ID).getSheets()[0];
}

function checkAdminToken_(token) {
  var real = PropertiesService.getScriptProperties().getProperty("ADMIN_TOKEN");
  return real && token === real;
}

function submitLead_(body) {
  var name = (body.name || "").toString().trim();
  var email = (body.email || "").toString().trim();
  var phone = (body.phone || "").toString().trim();
  var timeline = (body.timeline || "").toString().trim();
  var source = (body.source || "direct").toString().trim();
  var lang = (body.lang || "en").toString().trim();

  var sheet = getSheet_();
  sheet.appendRow([new Date(), name, email, phone, timeline, source, lang, "FALSE"]);

  sendGuideEmail_(name, email, lang);
  notifyMaria_(name, email, phone, timeline, source);
}

function sendGuideEmail_(name, email, lang) {
  var isEs = lang === "es";

  var subject = isEs
    ? "Tu Guia para Comprar tu Primera Casa"
    : "Your First Home Buyer Guide";

  var greeting = name ? (isEs ? "Hola " + name + "," : "Hi " + name + ",") : (isEs ? "Hola," : "Hi,");

  var bodyText = isEs
    ? greeting + "\n\nAqui esta tu guia gratuita para compradores de primera vez, con mitos sobre el dinero, numeros reales, y el proceso paso a paso.\n\nSi tienes preguntas, responde este correo o escribeme al 919-671-5108.\n\nMaria Rodriguez\nKeller Williams Realty Cary\n@mariainthetriangle"
    : greeting + "\n\nHere's your free First-Time Buyer Guide - money myths, real numbers, and the step-by-step process.\n\nQuestions? Just reply to this email or text me at 919-671-5108.\n\nMaria Rodriguez\nKeller Williams Realty Cary\n@mariainthetriangle";

  var attachment = UrlFetchApp.fetch(GUIDE_URL).getBlob().setName("Your First Home Buyer Guide.pdf");

  MailApp.sendEmail({
    to: email,
    subject: subject,
    body: bodyText,
    attachments: [attachment],
    name: "Maria Rodriguez"
  });
}

function notifyMaria_(name, email, phone, timeline, source) {
  MailApp.sendEmail({
    to: NOTIFY_EMAIL,
    subject: "New lead: " + (name || "(no name)") + " - " + source,
    body: "New lead from the Instagram hub.\n\nName: " + name + "\nEmail: " + email + "\nPhone: " + phone
      + "\nTimeline: " + timeline + "\nSource: " + source
      + "\n\nThey were automatically emailed the guide, and will be synced to Follow Up Boss shortly."
  });
}

function adminListUnsyncedLeads_(p) {
  if (!checkAdminToken_(p.adminToken)) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: "unauthorized" }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var sheet = getSheet_();
  var values = sheet.getDataRange().getValues();
  var leads = [];

  for (var i = 1; i < values.length; i++) {
    var row = values[i];
    var synced = (row[7] || "").toString().trim().toUpperCase();
    if (synced === "TRUE") continue;
    if (!row[2]) continue; // no email, skip blank rows

    leads.push({
      row: i + 1,
      timestamp: row[0] instanceof Date ? row[0].toISOString() : row[0],
      name: row[1],
      email: row[2],
      phone: row[3],
      timeline: row[4],
      source: row[5],
      lang: row[6]
    });
  }

  return ContentService.createTextOutput(JSON.stringify({ ok: true, leads: leads }))
    .setMimeType(ContentService.MimeType.JSON);
}

function adminMarkSynced_(body) {
  if (!checkAdminToken_(body.adminToken)) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: "unauthorized" }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var sheet = getSheet_();
  var rows = body.rows || [];
  for (var i = 0; i < rows.length; i++) {
    sheet.getRange(rows[i], 8).setValue("TRUE");
  }

  return ContentService.createTextOutput(JSON.stringify({ ok: true, updated: rows.length }))
    .setMimeType(ContentService.MimeType.JSON);
}
